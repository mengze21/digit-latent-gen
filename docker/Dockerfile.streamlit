FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1

WORKDIR /app

# Install runtime dependencies for Streamlit deployment
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install CPU PyTorch
RUN pip install --no-cache-dir \
    torch==2.7.0 \
    torchvision==0.22.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Copy packaging metadata first for better layer caching.
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs/generate_config.yaml ./configs/generate_config.yaml
COPY configs/diffusion_config.yaml ./configs/diffusion_config.yaml
COPY streamlit_app.py ./

# Install the project in production mode
RUN pip install --no-cache-dir .

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Create runtime directories with proper permissions
RUN mkdir -p /app/data /app/outputs /app/checkpoints && \
    chown -R appuser:appuser /app

# Checkpoints and outputs are intended to be mounted at runtime.
VOLUME ["/app/checkpoints", "/app/outputs"]

# Switch to non-root user for security
USER appuser

EXPOSE 8501

# Default command for Streamlit deployment
CMD ["streamlit", "run", "streamlit_app.py", "--server.address", "0.0.0.0", "--server.port", "8501"]
